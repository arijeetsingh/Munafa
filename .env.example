# Copy to .env (in the project root). Every value is optional for local development.

# MongoDB connection string. Leave empty to use an embedded MongoDB that
# stores data in server/.data (no install needed).
MONGO_URI=

# Secret used to sign login tokens. Set a long random string in production.
JWT_SECRET=change-me-in-production

# API port (the Vite dev server proxies /api to it).
PORT=4000

# Optional: Claude API key. When set, Claude parses speech and writes the daily
# tip; otherwise the built-in rule-based Hinglish parser is used.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Development only: show the one-time login code on screen instead of sending
# an SMS. Turn off in production and wire an SMS provider in routes/auth.js.
DEMO_OTP=true
